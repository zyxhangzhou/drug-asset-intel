  {
   "hasResults": true,
   "protocolSection": {
    "armsInterventionsModule": {
     "armGroups": [
      {
       "description": "Participants received their ongoing therapy for polycythemia vera (PV) along with rusfertide-matching placebo, subcutaneous (SC) injection, once weekly, from baseline up to Week 32.",
       "interventionNames": [
        "Drug: Placebo"
       ],
       "label": "Part 1a: Randomized, Double-Blind Period: Placebo",
       "type": "PLACEBO_COMPARATOR"
      },
      {
       "description": "Participants received their ongoing therapy for PV along with rusfertide once weekly, SC injection, from baseline up to Week 32. Rusfertide doses were titrated to maintain hematocrit less than (\\<) 45 percent (%). The starting dose was 19 milligrams (mg). The doses that were administered to Part 1a participants were 9.5, 19, 28, 41, 54, 69 and 82 mg.",
       "interventionNames": [
        "Drug: Rusfertide"
       ],
       "label": "Part 1a: Randomized, Double-Blind Period: Rusfertide",
       "type": "EXPERIMENTAL"
      },
      {
       "description": "Participants received rusfertide once weekly, SC injection, from Weeks 32 to 52. Rusfertide doses were titrated to maintain hematocrit \\< 45%. Participants who received rusfertide in Part 1a continued at their current dose unless dose adjustment was required. Participants who received placebo in Part 1a started rusfertide at 19 mg. The doses that were administered to Part 1b participants were 9.5, 19, 28, 41, 54, 69 and 82 mg.",
       "interventionNames": [
        "Drug: Rusfertide"
       ],
       "label": "Part 1b: Open-Label Treatment Period: Rusfertide",
       "type": "EXPERIMENTAL"
      },
      {
       "description": "Participants received rusfertide once weekly, SC injection, from Weeks 52 to 156. Rusfertide doses were titrated to maintain hematocrit \\< 45%. The doses that were administered to Part 2 participants were 9.5, 19, 28, 41, 54, 69, 82, 95 and 108 mg. For weekly doses greater than (\\>) 90 mg, the dose of rusfertide was and will be divided into 2 doses administered 3 to 4 days apart.",
       "interventionNames": [
        "Drug: Rusfertide"
       ],
       "label": "Part 2: Long Term Extension Period: Rusfertide",
       "type": "EXPERIMENTAL"
      },
      {
       "description": "Participants will receive rusfertide once weekly, SC injection, from Week 156 to the end of the study (approximately 5 years). Rusfertide doses will be titrated to maintain hematocrit \\< 45%. The doses that will be administered to Part 3 participants are 9.5, 19, 28, 41, 54, 69, 82, 95 and 108 mg. For weekly doses \\> 90 mg, the dose of rusfertide will be divided into 2 doses administered 3 to 4 days apart.",
       "interventionNames": [
        "Drug: Rusfertide"
       ],
       "label": "Part 3: Treatment Extension Period: Rusfertide",
       "type": "EXPERIMENTAL"
      }
     ],
     "interventions": [
      {
       "armGroupLabels": [
        "Part 1a: Randomized, Double-Blind Period: Rusfertide",
        "Part 1b: Open-Label Treatment Period: Rusfertide",
        "Part 2: Long Term Extension Period: Rusfertide",
        "Part 3: Treatment Extension Period: Rusfertide"
       ],
       "description": "Rusfertide SC injection",
       "name": "Rusfertide",
       "type": "DRUG"
      },
      {
       "armGroupLabels": [
        "Part 1a: Randomized, Double-Blind Period: Placebo"
       ],
       "description": "Rusfertide-matching placebo SC injection",
       "name": "Placebo",
       "type": "DRUG"
      }
     ]
    },
