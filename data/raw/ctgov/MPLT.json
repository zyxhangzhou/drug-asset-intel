   "protocolSection": {
    "armsInterventionsModule": {
     "armGroups": [
      {
       "description": "ML-004 is a bilayer immediate-release (IR)/extended-release (ER, gastroretentive) oral tablet formulation. ML-004 is taken orally once daily and provided as a tablet in two dose strengths of 12 mg (3 mg IR/9 mg ER) and 24 mg tablet (6 mg IR/18 mg ER). Dose levels for this study are 12 mg (provided as one 12 mg tablet), 24 mg (one 24 mg tablet), 48 mg (two 24 mg tablets), and 72 mg (three 24 mg tablets).",
       "interventionNames": [
        "Drug: ML-004 (IR)/(ER) tablet"
       ],
       "label": "ML-004 (IR)/(ER) tablet",
       "type": "EXPERIMENTAL"
      },
      {
       "description": "Matched placebo oral tablets will consist of same excipients as the investigational drug but without any ML-004. Placebo taken orally once daily to match tablet number of ML-004 dose levels for 12 mg (1 tablet), 24 mg (1 tablet), 48 mg (2 tablets), and 72 mg (3 tablets).",
       "interventionNames": [
        "Drug: ML-004 Placebo"
       ],
       "label": "ML-004 Placebo",
       "type": "PLACEBO_COMPARATOR"
      }
     ],
     "interventions": [
      {
       "armGroupLabels": [
        "ML-004 (IR)/(ER) tablet"
       ],
       "description": "Participants will receive ML-004 once daily.",
       "name": "ML-004 (IR)/(ER) tablet",
       "type": "DRUG"
      },
      {
       "armGroupLabels": [
        "ML-004 Placebo"
       ],
       "description": "Participants will receive matching placebo once daily.",
       "name": "ML-004 Placebo",
       "type": "DRUG"
      }
     ]
    },
