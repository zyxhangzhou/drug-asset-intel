   "protocolSection": {
    "armsInterventionsModule": {
     "armGroups": [
      {
       "description": "Healthy volunteer subject cohorts randomized 6:2 receiving a single dose of KT-474 or placebo. The first cohort will receive 25 mg of KT-474 or placebo. Dose escalation will occur if KT-474 or placebo is tolerated.",
       "interventionNames": [
        "Drug: KT-474/Placebo"
       ],
       "label": "Single ascending dose cohorts in healthy subjects",
       "type": "EXPERIMENTAL"
      },
      {
       "description": "Healthy volunteer subject cohorts randomized 9:3 to receive KT-474 or placebo for 14 days continuous dosing. The first cohort will receive a dose of KT-474 or placebo determined to be safe based on data generated in the SAD portion.",
       "interventionNames": [
        "Drug: KT-474/Placebo"
       ],
       "label": "Multiple ascending dose cohorts in healthy subjects",
       "type": "EXPERIMENTAL"
      },
      {
       "description": "Healthy Volunteer SAD subject cohorts (up to 5) will receive a single dose of KT-474 in the fed state.",
       "interventionNames": [
        "Drug: KT-474/Placebo"
       ],
       "label": "Food Effect Cohort in healthy subjects",
       "type": "EXPERIMENTAL"
      },
      {
       "description": "A single cohort of up to 30 patients with AD or HS to receive a dose of KT-474 determined to be safe based on data generated in the healthy volunteer MAD portion, dosed daily X 28 days.",
       "interventionNames": [
        "Drug: KT-474"
       ],
       "label": "Multiple dose cohort in HS and AD patients",
       "type": "EXPERIMENTAL"
      },
      {
       "description": "Healthy volunteer subject cohorts randomized 9:3 to receive KT-474 or placebo every other day over 14 days, and/or twice weekly over 15 days. The first cohort will receive a dose of KT-474 or placebo determined to be safe based on data generated in the SAD and MAD portion.",
       "interventionNames": [
        "Drug: KT-474/Placebo"
       ],
       "label": "Multiple dose cohorts in healthy subjects",
       "type": "EXPERIMENTAL"
      }
     ],
