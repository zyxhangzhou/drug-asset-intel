# Copy to .env and fill in. Never commit .env.

# SQLite snapshot the app serves (read-only) and the pipeline writes.
INTEL_DB_PATH=data/processed/intel.db
# Built frontend served by the API.
INTEL_WEB_DIST=web/dist
# Optional shared password for the deployed site (HTTP basic auth, any username).
# Leave empty to serve without a password; /api/health always stays open.
INTEL_ACCESS_PASSWORD=

# SEC EDGAR requires a descriptive User-Agent with a contact address.
SEC_USER_AGENT="YourName your-email@example.com"

# Primary extraction model (OpenAI-compatible endpoint): DeepSeek official API.
# DeepSeek does not publish dated model names; the pipeline records the model
# string the API returns with each extraction.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
LLM_API_KEY=

# Cross-check model: Qwen on Alibaba Model Studio. Copy the workspace
# "openAiCompatible" URL from the console's API key export. Pin a dated version.
LLM_VERIFY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VERIFY_MODEL=qwen3.7-plus-2026-05-26
LLM_VERIFY_API_KEY=
