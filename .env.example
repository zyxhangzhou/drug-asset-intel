# Copy to .env and fill in. Never commit .env.

# SQLite snapshot the app serves (read-only) and the pipeline writes.
INTEL_DB_PATH=data/processed/intel.db
# Built frontend served by the API.
INTEL_WEB_DIST=web/dist

# SEC EDGAR requires a descriptive User-Agent with a contact address.
SEC_USER_AGENT="YourName your-email@example.com"

# Primary extraction model (OpenAI-compatible endpoint). Alibaba Model Studio:
# copy the workspace "openAiCompatible" URL from the console's API key export.
# Pin a dated model version so extractions are reproducible.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.7-plus-2026-05-26
LLM_API_KEY=

# Cross-check model: a different model family, same Model Studio key works.
LLM_VERIFY_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_VERIFY_MODEL=deepseek-v4-pro-0813
LLM_VERIFY_API_KEY=
