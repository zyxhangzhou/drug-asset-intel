# Copy to .env and fill in. Never commit .env.

# SQLite snapshot the app serves (read-only) and the pipeline writes.
INTEL_DB_PATH=data/processed/intel.db
# Built frontend served by the API.
INTEL_WEB_DIST=web/dist

# SEC EDGAR requires a descriptive User-Agent with a contact address.
SEC_USER_AGENT="YourName your-email@example.com"

# Primary extraction model (OpenAI-compatible endpoint), e.g. DeepSeek.
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Cross-check model (OpenAI-compatible endpoint), e.g. Qwen on Model Studio.
LLM_VERIFY_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_VERIFY_MODEL=qwen-plus
LLM_VERIFY_API_KEY=
